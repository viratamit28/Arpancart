// 1. Connection define kar rahe hain
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  PAUSED_SKIPPED
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==========================================
// 🧑‍🤝‍🧑 1. USER TABLE 
// ==========================================
model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique // REQUIRED KIYA HAI
  mobileNumber  String         @unique // NAYA FIELD ADD KIYA HAI
  password      String?        
  otp           String?        
  otpExpiry     DateTime?      
  role          String         @default("customer")
  createdAt     DateTime       @default(now())
  
  // Relations
  orders        Order[]
  addresses     Address[]
  subscriptions Subscription[] 
}

// ==========================================
// 🏠 2. ADDRESS TABLE 
// ==========================================
model Address {
  id        Int      @id @default(autoincrement())
  userId    Int      
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ==========================================
// 🗂️ 3. CATEGORY & SUB-CATEGORY 
// ==========================================
model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  imageUrl      String?       
  isActive      Boolean       @default(true) 
  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]
}

// ==========================================
// 🛍️ 4. PRODUCT TABLE 
// ==========================================
model Product {
  id              Int       @id @default(autoincrement())
  title           String
  description     String    @db.Text
  price           Float
  discountedPrice Float?   
  
  // Category Relations
  categoryString  String?  
  categoryId      Int?
  subCategoryId   Int?
  
  imageUrl        String
  stockQuantity   Int       @default(0)
  deliveryCharge  Float     @default(0) 
  
  isTrending      Boolean   @default(false) 
  
  createdAt       DateTime  @default(now())

  // Free Gift Feature 
  freeGiftId      Int?
  freeGift        Product?  @relation("FreeGiftRelation", fields: [freeGiftId], references: [id])
  givenAsFreeGift Product[] @relation("FreeGiftRelation")

  // Relations
  category        Category?    @relation(fields: [categoryId], references: [id])
  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id])
  orderItems      OrderItem[]
}

// ==========================================
// 📦 5. ORDER & ORDER ITEM 
// ==========================================
model Order {
  id              Int         @id @default(autoincrement())
  userId          Int         
  totalAmount     Float
  deliveryFee     Float       @default(0) 
  discount        Float       @default(0) 
  couponApplied   String?  
  
  shippingAddress String      @db.Text
  
  status          OrderStatus @default(PENDING) 
  
  paymentMethod   String      @default("COD") 
  paymentStatus   String      @default("PENDING") 
  transactionId   String?     
  
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// ==========================================
// 🎟️ 6. COUPONS 
// ==========================================
model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  String   
  discountValue Float
  minOrderValue Float    @default(0)
  expiryDate    DateTime
  usageCount    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// ==========================================
// 🔄 7. 7-DAY GOD CAROUSEL 
// ==========================================
model DayCarousel {
  id        Int     @id @default(autoincrement())
  dayOfWeek String   
  imageUrl  String  @db.Text 
  isActive  Boolean @default(true)
}

// ==========================================
// ⚙️ 8. ADMIN SITE SETTINGS 
// ==========================================
model SiteSetting {
  id                Int     @id @default(1)
  whatsappNumber    String? 
  facebookUrl       String?
  instagramUrl      String?
  trendingBannerUrl String? @db.Text 
  trendingTitle     String?
}

// ==========================================
// 📅 9. SUBSCRIPTIONS & DELIVERIES 
// ==========================================
model SubscriptionPlan {
  id           Int            @id @default(autoincrement())
  name         String         
  price        Float
  durationDays Int            
  isActive     Boolean        @default(true)
  
  subscriptions Subscription[]
}

model Subscription {
  id            Int                @id @default(autoincrement())
  userId        Int
  planId        Int
  startDate     DateTime           
  endDate       DateTime           
  remainingDays Int                
  status        SubscriptionStatus @default(ACTIVE) 
  pausedAt      DateTime?          
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id])
  deliveries    SubscriptionDelivery[] 
}

model SubscriptionDelivery {
  id             Int            @id @default(autoincrement())
  subscriptionId Int
  deliveryDate   DateTime
  status         DeliveryStatus @default(PENDING) 
  createdAt      DateTime       @default(now())

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ==========================================
// 📧 10. CONTACT TABLE 
// ==========================================
model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String   @db.Text  
  createdAt DateTime @default(now())
}